{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "india-by-numbers",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-18",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "indiabynumbers.org", "custom_domain": true },
    { "pattern": "www.indiabynumbers.org", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "india-by-numbers",
      "database_id": "97674440-8e04-4660-b802-784770031bb0",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
