---
/** A topic's silver object, cut out of its backdrop, so it sits on any ground with no box or glow. */
interface Props {
  name: string
  alt: string
  size?: number
  /** Kajal grounds: the object was made on black and uses the screen blend. */
  screen?: boolean
  eager?: boolean
}
const { name, alt, size = 280, screen = false, eager = false } = Astro.props
---

<img
  class:list={['emblem', { screen }]}
  src={`/emblems/${name}.webp`}
  alt={alt}
  width={size}
  height={size}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
  style={`width:${size}px;height:${size}px`}
/>

<style>
  .emblem {
    object-fit: contain;
    flex-shrink: 0;
    /* The cut-outs lost their cast shadow; one soft shadow puts them back on the ground. */
    filter: drop-shadow(0 14px 18px rgb(0 0 0 / 0.3));
  }
  .screen {
    mix-blend-mode: screen;
    filter: none;
  }
</style>
