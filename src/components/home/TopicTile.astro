---
/**
 * A topic as a flat pigment block: chart count, emblem, name, two questions, one figure.
 * A topic with no object yet has no medallion; its name stays on the same line as its neighbours'.
 */
import Medallion from '../Medallion.astro'
import FigureValue from '../FigureValue.astro'
import { charts } from '~/content'
import type { Tile } from '~/content/pages/tiles'
import type { Topic } from '~/content/types'
import { pigments } from '~/lib/tokens'

interface Props {
  topic: Topic
  tile: Tile
}
const { topic, tile } = Astro.props
const p = pigments[topic.slug]
const count = charts.filter((c) => c.topic.slug === topic.slug).length
---

<li class:list={['tile', p.text === 'light' ? 'on-dark' : 'on-light']} style={`--ground:${p.hex}`} data-jaali>
  <p class="label count">{count} charts</p>
  <Medallion topic={topic.slug} size={156} deep />
  <h3>
    <a href={`/${topic.slug}/`} class="display">{topic.name}</a>
    <span class="deva" lang="hi">{topic.hindi}</span>
  </h3>
  <ul class="questions">{tile.questions.map((q) => <li>{q}</li>)}</ul>
  <div class="fig"><FigureValue figure={tile.figure} size="tile" /></div>
</li>

<style>
  .tile {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-rows: auto 1fr auto auto auto;
    padding: 24px;
    background: var(--ground);
    border-radius: 4px;
    min-height: 460px;
  }
  .on-light {
    color: var(--ink);
  }
  /*
   * A jaali, like a carved stone screen, set around the object.
   * At rest (::before) the lattice spreads out a little from the medallion and fades before the
   * text. On hover or focus it grows a little further round the medallion (--reach grows).
   * A faint pointer light (::after) brightens the lattice under the pointer (--mx, --my, set by the
   * script below). Both layers use the same tile-relative lattice, so their lines meet exactly.
   */
  @property --reach {
    syntax: '<length>';
    inherits: false;
    initial-value: 180px;
  }
  .tile::before,
  .tile::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: currentColor;
    pointer-events: none;
  }
  .tile::before {
    --reach: 180px;
    opacity: 0.13;
    mask:
      url('/patterns/jaali.svg') 0 0 / 56px 56px repeat,
      radial-gradient(circle var(--reach) at calc(100% - 98px) 98px, #000 30%, transparent);
    /* After the shorthand, which resets it. */
    mask-composite: intersect;
  }
  .tile::after {
    opacity: 0;
    mask:
      url('/patterns/jaali.svg') 0 0 / 56px 56px repeat,
      radial-gradient(circle 160px at var(--mx, 70%) var(--my, 30%), #000, transparent 72%);
    mask-composite: intersect;
  }
  .tile > :global(.medallion) {
    transition: transform 420ms cubic-bezier(0.19, 1, 0.22, 1);
  }
  @media (prefers-reduced-motion: no-preference) {
    .tile::before {
      transition: --reach 700ms cubic-bezier(0.19, 1, 0.22, 1);
    }
    .tile::after {
      transition: opacity 320ms cubic-bezier(0.19, 1, 0.22, 1);
    }
  }
  .tile:hover::before,
  .tile:focus-within::before {
    --reach: 300px;
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .tile:hover::after {
      opacity: 0.06;
    }
  }
  .tile > :global(.medallion) {
    position: absolute;
    top: 20px;
    right: 20px;
  }
  .count {
    opacity: 0.85;
  }
  h3 {
    margin-top: 180px;
    display: grid;
  }
  h3 a {
    font-size: 30px;
    text-decoration: none;
  }
  h3 a::after {
    /* The whole tile is the link. */
    content: '';
    position: absolute;
    inset: 0;
  }
  h3 a:hover {
    text-decoration: underline;
  }
  .deva {
    font-size: 19px;
    line-height: 28px;
  }
  .questions {
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
    font-size: 15px;
    line-height: 22px;
  }
  .fig {
    position: relative;
    z-index: 1;
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid color-mix(in srgb, currentColor 35%, transparent);
  }
  .on-light .fig :global(.punch) {
    color: var(--on-light-dim);
  }
</style>

<script>
  // Light the jaali under the pointer and tilt the medallion a little toward it. Hover only, and
  // nothing for readers who ask for less motion.
  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches
  if (fine && !still) {
    for (const tile of document.querySelectorAll<HTMLElement>('[data-jaali]')) {
      const medallion = tile.querySelector<HTMLElement>('.medallion')
      let frame = 0
      let last: PointerEvent | undefined
      const paint = () => {
        frame = 0
        if (!last) return
        const r = tile.getBoundingClientRect()
        const x = last.clientX - r.left
        const y = last.clientY - r.top
        tile.style.setProperty('--mx', `${x}px`)
        tile.style.setProperty('--my', `${y}px`)
        if (medallion) {
          const m = medallion.getBoundingClientRect()
          const dx = (last.clientX - (m.left + m.width / 2)) / r.width
          const dy = (last.clientY - (m.top + m.height / 2)) / r.height
          medallion.style.transform = `perspective(700px) rotateY(${(dx * 14).toFixed(2)}deg) rotateX(${(-dy * 14).toFixed(2)}deg)`
        }
      }
      tile.addEventListener('pointermove', (e) => {
        last = e
        if (!frame) frame = requestAnimationFrame(paint)
      })
      tile.addEventListener('pointerleave', () => {
        last = undefined
        if (medallion) medallion.style.transform = ''
      })
    }
  }
</script>
