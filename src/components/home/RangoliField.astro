---
/**
 * The home hero's background: a faint dot grid (pulli), and rangoli that bloom along the pointer's
 * path, each a new design. The look lives in src/content/rangoli.json; tune it at /lab/rangoli/.
 * Takes no clicks. A tap blooms one on a touch screen. Only the dot grid for readers who ask for
 * less motion.
 */
---

<canvas class="rangoli" aria-hidden="true" data-rangoli></canvas>

<style>
  .rangoli {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>

<script>
  import config from '~/content/rangoli.json'
  import { createField, type RangoliConfig } from '~/lib/rangoli/field'
  import { INKS } from '~/lib/rangoli/palette'

  const still = matchMedia('(prefers-reduced-motion: reduce)').matches
  for (const canvas of document.querySelectorAll<HTMLCanvasElement>('[data-rangoli]')) {
    const host = canvas.parentElement!
    // The headline, the search and the suggestions: only faint giants bloom over them.
    const avoid = () => {
      const base = host.getBoundingClientRect()
      return [...host.querySelectorAll('h1, form, .try')].map((el) => {
        const r = el.getBoundingClientRect()
        return new DOMRect(r.left - base.left - 12, r.top - base.top - 12, r.width + 24, r.height + 24)
      })
    }
    const field = createField(host, canvas, INKS, config as RangoliConfig, avoid)
    if (still) continue
    const last = { x: -1e4, y: -1e4 }
    const at = (e: PointerEvent) => {
      const r = host.getBoundingClientRect()
      return { x: e.clientX - r.left, y: e.clientY - r.top }
    }
    host.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return
      const p = at(e)
      if (Math.hypot(p.x - last.x, p.y - last.y) < config.stride) return
      Object.assign(last, p)
      field.bloom(p.x, p.y)
    })
    host.addEventListener('pointerleave', () => Object.assign(last, { x: -1e4, y: -1e4 }))
    host.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse') return
      const p = at(e)
      field.bloom(p.x, p.y)
    })
  }
</script>
