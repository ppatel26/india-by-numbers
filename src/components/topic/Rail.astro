---
/** The topic rail: parts on this page, the state comparison, and short notes. */
import StateSelect from '../StateSelect.astro'
import type { Topic } from '~/content/types'
import { partId } from '~/content'

interface Props {
  topic: Topic
}
const { topic } = Astro.props
---

<aside class="rail" aria-label="On this page">
  <div class="block contents">
    <h2 class="label muted">On this page</h2>
    <ol>
      {topic.parts.map((p, i) => <li><a href={`#${partId(i + 1)}`}>{p.title}</a></li>)}
      <li><a href="#about-the-data">About the data</a></li>
    </ol>
  </div>
  <div class="block">
    <h2 class="label muted">Your state</h2>
    <StateSelect label="Choose a state" />
    <p class="on" data-state-on hidden></p>
    <a class="page-link" data-state-only data-state-link hidden href="/states/">All figures for <span data-state-name></span></a>
  </div>
  {topic.rail?.map((n) => (
    <div class="block note">
      <h2 class="label muted">{n.title}</h2>
      <dl>
        {n.rows.map(([when, what]) => (
          <div><dt class="label muted">{when}</dt><dd>{what}</dd></div>
        ))}
      </dl>
      {n.source && <p class="source">{n.source}</p>}
    </div>
  ))}
</aside>

<style>
  .rail {
    min-width: 0;
    position: sticky;
    top: 24px;
    align-self: start;
    display: grid;
    gap: 32px;
  }
  .block {
    padding-top: 16px;
    border-top: 1px solid var(--ink);
  }
  h2 {
    margin-bottom: 14px;
  }
  ol {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: part;
    display: grid;
    gap: 12px;
    font-size: 15px;
    line-height: 20px;
  }
  li {
    counter-increment: part;
    display: grid;
    grid-template-columns: 20px 1fr;
  }
  li::before {
    content: counter(part);
    color: var(--slate);
  }
  li a {
    text-decoration: none;
  }
  li a:hover {
    text-decoration: underline;
  }
  .on {
    margin-top: 12px;
    font-size: 14px;
    line-height: 20px;
    color: var(--slate);
  }
  .on a {
    color: var(--ink);
  }
  .page-link {
    display: inline-block;
    margin-top: 8px;
    font-size: 14px;
    font-weight: 600;
  }
  .note dl {
    display: grid;
    gap: 8px;
    margin: 0;
  }
  .note dt {
    line-height: 18px;
  }
  .note dd {
    margin: 0;
    font-size: 14px;
    line-height: 20px;
  }
  .note .source {
    margin-top: 12px;
    font-size: 12px;
    color: var(--slate);
  }
  @media (max-width: 1100px) {
    .rail {
      position: static;
    }
  }
  @media (max-width: 720px) {
    /* Phones scroll the parts in order; the list would push the first chart down a screen. */
    .contents {
      display: none;
    }
  }
</style>
