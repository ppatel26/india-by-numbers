---
import type { Topic } from '~/content/types'
import { charts } from '~/content'
import { formatDate } from '~/lib/period'
import { latestChecked } from '~/lib/site'

interface Props {
  topic: Topic
}
const { topic } = Astro.props
const mine = charts.filter((c) => c.topic.slug === topic.slug)
const count = mine.length
// One short line: when we last checked, and how many charts. Sources are on each chart and in About the data.
const items = [`Updated ${formatDate(latestChecked(mine.map((c) => c.chart)))}`, `${count} charts`]
---

<div class="strip">
  <div class="wrap row">
    <p class="label muted">{items.join(' · ')}</p>
    <a href="/releases/">All releases</a>
  </div>
</div>

<style>
  .strip {
    border-bottom: 1px solid var(--rule);
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-block: 12px;
  }
  a {
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
  }
</style>
