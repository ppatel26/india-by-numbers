---
import Crumbs from '../Crumbs.astro'
import Emblem from '../Emblem.astro'
import FigureValue from '../FigureValue.astro'
import type { Topic } from '~/content/types'
import { EMBLEM_ALT } from '~/lib/emblems'
import { pigments } from '~/lib/tokens'

interface Props {
  topic: Topic
}
const { topic } = Astro.props
const pigment = pigments[topic.slug]
---

<header class:list={['hero', pigment.text === 'light' ? 'on-dark' : 'on-light']} style={`--ground:${pigment.hex}`}>
  <div class="wrap inner">
    <div class="text">
      <Crumbs trail={[['Topics', '/topics/']]} current={topic.name} />
      <h1 class="display title">
        {topic.name} <span class="deva" lang="hi">{topic.hindi}</span>
      </h1>
      <p class="standfirst">{topic.standfirst}</p>
      <div class="figures">
        {topic.figures.map((f) => <FigureValue figure={f} />)}
      </div>
    </div>
    <Emblem name={topic.slug} alt={EMBLEM_ALT[topic.slug]} eager />
  </div>
</header>

<style>
  .hero {
    background: var(--ground);
    color: var(--ink);
  }
  .on-dark {
    color: var(--silver);
  }
  .inner {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    min-height: 320px;
    padding-block: 20px;
  }
  .hero :global(.crumbs) {
    color: inherit;
  }
  .title {
    margin-top: 6px;
    font-size: clamp(36px, 5vw, 64px);
  }
  .deva {
    font-size: 0.62em;
    margin-left: 8px;
  }
  .standfirst {
    margin-top: 8px;
    max-width: 640px;
    font-size: 18px;
    line-height: 27px;
  }
  .figures {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 264px));
    gap: 24px;
    margin-top: 18px;
  }
  .figures > :global(*) {
    padding-top: 12px;
    border-top: 1px solid color-mix(in srgb, currentColor 40%, transparent);
  }
  .figures :global(.value) {
    font-size: 36px;
    line-height: 42px;
  }
  .on-light :global(.punch) {
    color: var(--on-light-dim);
  }
  @media (max-width: 900px) {
    /* Phones: a small object beside the title, and the three figures side by side. */
    .inner > :global(.emblem) {
      position: absolute;
      top: 12px;
      right: 0;
      width: 88px !important;
      height: 88px !important;
    }
    .text {
      min-width: 0;
    }
    .title {
      padding-right: 92px;
    }
    .standfirst {
      font-size: 16px;
      line-height: 24px;
    }
    .figures {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
    }
    .figures :global(.value) {
      font-size: 22px;
      line-height: 28px;
    }
    .figures :global(.name) {
      font-size: 13px;
      line-height: 18px;
    }
    .figures :global(.punch) {
      font-size: 10px;
      letter-spacing: 0.04em;
    }
  }
</style>
