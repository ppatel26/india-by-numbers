---
import Crumbs from '../Crumbs.astro'
import Emblem from '../Emblem.astro'
import FigureValue from '../FigureValue.astro'
import type { Topic } from '~/content/types'
import { emblemAlt } from '~/lib/emblems'
import { pigments } from '~/lib/tokens'
import { SITE } from '~/lib/site'
import { proseHtml } from '~/lib/prose'

interface Props {
  topic: Topic
}
const { topic } = Astro.props
const pigment = pigments[topic.slug]
/** No object yet: the text takes the full width, and nothing stands in for the object. */
const alt = emblemAlt(topic.slug)

/*
 * The die: the hero is the face of a coin, cropped by the frame. The object is the device, and a
 * legend runs round it, as on a struck coin: the topic and the site, in English and Hindi. The
 * legend is struck into the ground, tone on tone, inside a beaded rim.
 */
const R = 186
// The legend starts at the left and runs up over the top, so the topic name sits where the frame
// does not crop it.
const CIRC = 2 * Math.PI * R
const legend = [
  { text: topic.name.toUpperCase(), deva: false },
  { text: topic.hindi, deva: true },
  { text: SITE.name.toUpperCase(), deva: false },
  { text: SITE.hindiName, deva: true },
]
// About 11 px a character at this size: repeat the legend while it fills less than the ring.
const once = legend.reduce((n, l) => n + l.text.length + 3, 0) * 11
const turns = Math.max(1, Math.floor(CIRC / once))
const parts = Array.from({ length: turns }, () => legend).flat()
---

<header class:list={['hero', pigment.text === 'light' ? 'on-dark' : 'on-light', { bare: alt === undefined }]} style={`--ground:${pigment.hex}`}>
  <div class="wrap inner">
    <div class="text">
      <Crumbs trail={[['Topics', '/topics/']]} current={topic.name} />
      <h1 class="display title">
        {topic.name} <span class="deva" lang="hi">{topic.hindi}</span>
      </h1>
      <p class="standfirst" set:html={proseHtml(topic.standfirst)} />
      <div class="figures">
        {topic.figures.map((f) => <FigureValue figure={f} />)}
      </div>
    </div>
    <div class="die">
      <svg class="face" viewBox="-225 -225 450 450" aria-hidden="true" focusable="false">
        <defs>
          <path id={`legend-${topic.slug}`} d={`M ${-R} 0 A ${R} ${R} 0 1 1 ${R} 0 A ${R} ${R} 0 1 1 ${-R} 0`} />
        </defs>
        <circle class="rim" r="214" />
        <circle class="line" r="205" />
        <circle class="line" r="168" />
        <text class="legend">
          <textPath href={`#legend-${topic.slug}`} textLength={CIRC - 8} lengthAdjust="spacing">
            {parts.map((l) => (
              <>
                <tspan class:list={{ deva: l.deva }}>{l.text}</tspan>
                <tspan class="sep"> ✦ </tspan>
              </>
            ))}
          </textPath>
        </text>
      </svg>
      {alt !== undefined && <Emblem name={topic.slug} alt={alt} eager />}
    </div>
  </div>
</header>

<style>
  .hero {
    background: var(--ground);
    color: var(--ink);
    overflow: hidden;
  }
  .die {
    position: relative;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    /* The rim reaches 74 px past the object: keep that clear of the figures. */
    margin-left: 56px;
  }
  .die > :global(.emblem) {
    position: relative;
  }
  /*
   * Struck, not printed: the marks are the ground a shade deeper, with a light edge below and a
   * dark edge above, so they read as cut into the surface.
   */
  .face {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 450px;
    max-width: none;
    height: 450px;
    translate: -50% -50%;
    overflow: visible;
    --struck: color-mix(in oklab, var(--ground) 76%, black);
    filter: drop-shadow(0 1px 0 rgb(255 255 255 / 0.22)) drop-shadow(0 -1px 0 rgb(0 0 0 / 0.14));
  }
  .rim {
    fill: none;
    stroke: var(--struck);
    stroke-width: 7;
    stroke-linecap: round;
    stroke-dasharray: 0 15.5;
  }
  .line {
    fill: none;
    stroke: var(--struck);
    stroke-width: 1.5;
  }
  .legend {
    fill: var(--struck);
    font: 400 16px var(--font-display);
    letter-spacing: 0.12em;
  }
  .legend .deva {
    font-family: var(--font-deva);
    font-size: 18px;
    letter-spacing: 0;
  }
  .legend .sep {
    font-size: 12px;
  }
  /* One moment: the die strikes as the page opens. */
  @media (prefers-reduced-motion: no-preference) {
    .face {
      animation: strike 900ms cubic-bezier(0.16, 1, 0.3, 1) 120ms both;
    }
    @keyframes strike {
      from {
        opacity: 0;
        scale: 1.06;
      }
      to {
        opacity: 1;
        scale: 1;
      }
    }
  }
  .on-dark {
    color: var(--silver);
  }
  .inner {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    min-height: 320px;
    padding-block: 20px;
  }
  .hero :global(.crumbs) {
    color: inherit;
  }
  .title {
    margin-top: 6px;
    font-size: clamp(36px, 5vw, 64px);
  }
  .deva {
    font-size: 0.62em;
    margin-left: 8px;
    white-space: nowrap;
  }
  .standfirst {
    margin-top: 8px;
    max-width: 640px;
    font-size: 18px;
    line-height: 27px;
  }
  .figures {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 264px));
    gap: 24px;
    margin-top: 18px;
  }
  .figures > :global(*) {
    padding-top: 12px;
    border-top: 1px solid color-mix(in srgb, currentColor 40%, transparent);
  }
  .figures :global(.value) {
    font-size: 36px;
    line-height: 42px;
  }
  .on-light :global(.punch) {
    color: var(--on-light-dim);
  }
  @media (max-width: 900px) {
    /* Phones: a small object beside the title, and the three figures side by side. The rim and
       rings stay round it; the legend would be too small to read, so it goes. */
    .face {
      width: 120px;
      height: 120px;
    }
    .legend {
      display: none;
    }
    .die {
      position: absolute;
      top: 12px;
      right: 0;
      margin-left: 0;
    }
    .die > :global(.emblem) {
      width: 88px !important;
      height: 88px !important;
    }
    .text {
      min-width: 0;
    }
    .title {
      padding-right: 108px;
    }
    .bare .title {
      padding-right: 0;
    }
    .standfirst {
      font-size: 16px;
      line-height: 24px;
    }
    .figures {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
    }
    .figures :global(.value) {
      font-size: 22px;
      line-height: 28px;
    }
    .figures :global(.name) {
      font-size: 13px;
      line-height: 18px;
    }
    .figures :global(.punch) {
      font-size: 10px;
      letter-spacing: 0.04em;
    }
  }
</style>
