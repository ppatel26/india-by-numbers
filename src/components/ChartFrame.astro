---
/**
 * The chart frame, in a fixed order: number, title, subtitle, tabs, views,
 * note, then the footer (hallmark, downloads, short source line). Every view is
 * rendered at build time; src/scripts/chart.ts switches tabs.
 */
import ChartTable from './ChartTable.astro'
import Hallmark from './Hallmark.astro'
import type { Chart } from '~/content/types'
import type { PeriodLink } from '~/content'
import { openView, renderPlot, viewsOf, type View } from '~/lib/charts'
import { timelineOf } from '~/lib/charts/model'
import { sourceBrief } from '~/lib/sources'

interface Props {
  chart: Chart
  /** "2.1" on topic pages; none on the chart's own page. */
  number?: string
  /** The chart page uses h1 and links to nothing. */
  page?: boolean
  /** The period switch: the same measure at other time scales, each its own chart. */
  periods?: readonly PeriodLink[]
  /** A period not shown first on a topic page. */
  hidden?: boolean
}
const { chart, number, page = false, periods = [], hidden = false } = Astro.props
const views = viewsOf(chart)
const open = openView(chart)
const names: Record<View, string> = { chart: 'Chart', table: 'Table', map: 'Map' }
const id = `c-${chart.slug}`
const Heading = page ? 'h1' : 'h3'
const href = `/charts/${chart.slug}/`
// The month-by-month map shows on the chart's own page only, to keep topic pages light.
const steps = page && chart.kind === 'states' ? timelineOf(chart) : []
---

<figure class="chart" id={chart.slug} data-chart={chart.slug} aria-labelledby={`${id}-title`} hidden={hidden}>
  {number && <p class="label muted number">{number}</p>}
  <Heading class="chart-title" id={`${id}-title`}>{page ? chart.title : <a href={href}>{chart.title}</a>}</Heading>
  <p class="subtitle">{chart.subtitle}</p>
  {(periods.length > 1 || views.length > 1) && (
  <div class="controls">
  {periods.length > 1 && (
    <nav class="switch periods" aria-label="Period">
      {periods.map((p) => (
        <a href={`/charts/${p.slug}/`} data-period={p.slug} aria-current={p.slug === chart.slug ? (page ? 'page' : 'true') : undefined}>
          <span class="long">{p.label}</span><span class="short">{p.short}</span>
        </a>
      ))}
    </nav>
  )}
  {views.length > 1 && (
    <div class="switch chart-tabs" role="tablist" aria-label="View">
      {views.map((v) => (
        <button type="button" role="tab" id={`${id}-tab-${v}`} aria-controls={`${id}-${v}`} aria-selected={v === open ? 'true' : 'false'} tabindex={v === open ? 0 : -1} data-view={v}>
          {names[v]}
        </button>
      ))}
    </div>
  )}
  </div>
  )}
  {views.map((v) => (
    <div class:list={['view', v]} id={`${id}-${v}`} role={views.length > 1 ? 'tabpanel' : undefined} aria-labelledby={views.length > 1 ? `${id}-tab-${v}` : undefined} hidden={v !== open}>
      {v === 'table' ? (
        <ChartTable chart={chart} />
      ) : v === 'map' && steps.length > 0 ? (
        <div class="timeline" data-timeline>
          {steps.map((s, i) => (
            <div data-step={i} hidden={i !== steps.length - 1}>
              <div class="w-wide" set:html={renderPlot(s.chart, 'map', 'wide').html} />
              <div class="w-narrow" set:html={renderPlot(s.chart, 'map', 'narrow').html} />
            </div>
          ))}
          <label class="slider">
            <span class="label muted">{steps[0]!.label}</span>
            <input type="range" min="0" max={steps.length - 1} value={steps.length - 1} step="1" aria-label="Month" aria-valuetext={steps.at(-1)!.label} data-labels={steps.map((s) => s.label).join('|')} />
            <span class="label muted">{steps.at(-1)!.label}</span>
            <output class="label">{steps.at(-1)!.label}</output>
          </label>
        </div>
      ) : (
        <>
          <div class="w-wide" set:html={renderPlot(chart, v, 'wide').html} />
          <div class="w-narrow" set:html={renderPlot(chart, v, 'narrow').html} />
        </>
      )}
    </div>
  ))}
  {chart.note && <p class="note">Note: {chart.note}</p>}
  <figcaption class="foot">
    <Hallmark {...chart.punches} status={chart.status} />
    <p class="files">
      <span class="label muted">Download</span>
      <a href={`/charts/${chart.slug}.csv`} download title="The values in this chart, with unit and source on every row">CSV</a>
      {chart.kind !== 'table' && (
        <>
          <a href={`/charts/${chart.slug}.png`} download title="Image with title, hallmark and source line">PNG</a>
          <a href={`/charts/${chart.slug}.svg`} download title="Vector image, for print and editing">SVG</a>
        </>
      )}
    </p>
    <p class="source">{sourceBrief(chart.sources)}. <a href={page ? '#sources' : `${href}#sources`}>{page ? 'Full sources' : 'Details'}</a></p>
  </figcaption>
</figure>

<style>
  .chart {
    margin: 0;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
  }
  .number {
    margin-bottom: 8px;
  }
  .chart-title {
    font: 600 20px/28px var(--font-ui);
    /* No one-word last line ("October / 2026"). */
    text-wrap: balance;
  }
  h1.chart-title {
    font-size: clamp(26px, 3vw, 34px);
    line-height: 1.2;
  }
  .chart-title a {
    text-decoration: none;
  }
  .chart-title a:hover {
    text-decoration: underline;
  }
  .subtitle {
    margin-top: 4px;
    color: var(--slate);
    font-size: 15px;
    line-height: 22px;
    max-width: 912px;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    margin-top: 16px;
    max-width: 912px;
  }
  .switch {
    display: inline-flex;
    flex-wrap: wrap;
    padding: 3px;
    border: 1px solid var(--rule);
    border-radius: 20px;
  }
  .switch button,
  .switch a {
    border: 0;
    background: none;
    padding: 6px 16px;
    border-radius: 16px;
    font: 500 15px var(--font-ui);
    color: var(--ink);
    text-decoration: none;
    cursor: pointer;
  }
  .switch a:not([aria-current]):hover,
  .switch button[aria-selected='false']:hover {
    background: rgb(22 24 29 / 0.06);
  }
  .periods .short {
    display: none;
  }
  @media (max-width: 720px) {
    .periods .long {
      display: none;
    }
    .periods .short {
      display: inline;
    }
  }
  .switch button[aria-selected='true'],
  .switch a[aria-current] {
    background: var(--ink);
    color: var(--paper);
  }
  .view {
    margin-top: 24px;
  }
  .w-narrow {
    display: none;
  }
  @media (max-width: 720px) {
    .w-wide {
      display: none;
    }
    .w-narrow {
      display: block;
    }
  }
  .slider {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 12px;
    margin-top: 16px;
    max-width: 640px;
  }
  .slider input {
    accent-color: var(--ink);
  }
  .slider output {
    padding: 3px 9px;
    border: 1px solid var(--ink);
    border-radius: 11px;
  }
  .note {
    margin-top: 16px;
    font-size: 13px;
    line-height: 20px;
    color: var(--slate);
    max-width: 760px;
  }
  /* Row 1: hallmark, then the downloads at the right. Row 2: the source line, full width. */
  .foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px 24px;
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--rule);
  }
  .source {
    grid-column: 1 / -1;
    font-size: 13px;
    line-height: 20px;
    color: var(--slate);
    max-width: 760px;
  }
  .source a {
    color: inherit;
    text-underline-offset: 3px;
  }
  .source a:hover {
    color: var(--ink);
  }
  .files {
    display: flex;
    align-items: baseline;
    gap: 14px;
    font-size: 13px;
    line-height: 20px;
  }
  .files .label {
    margin-right: 2px;
  }
  .files a {
    color: var(--slate);
    text-decoration: none;
  }
  .files a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 720px) {
    .foot {
      grid-template-columns: minmax(0, 1fr);
    }
    .files {
      order: 1;
    }
  }
  /* Selected state (src/scripts/state.ts). */
  .chart :global(.is-sel .bar) {
    fill: var(--s1);
  }
  .chart :global(.is-sel .name) {
    font-weight: 600;
  }
  .chart :global(.is-sel .value.inside) {
    fill: var(--paper);
  }
  .chart :global(.tile.is-sel rect) {
    stroke: var(--ink);
    stroke-width: 2.5;
  }
  .chart :global(.hit:hover),
  .chart :global(.row:hover) {
    fill-opacity: 1;
  }
  .chart :global(.hit:hover) {
    fill: rgb(22 24 29 / 0.05);
  }
  .chart :global(.row:hover .name) {
    text-decoration: underline;
  }
</style>
