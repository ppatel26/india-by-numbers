---
/**
 * A topic object standing in an arched niche, the shape of a jharokha window. The arch is the
 * topic's pigment; on a pigment ground (`deep`) it is a darker shade of it.
 */
import Emblem from './Emblem.astro'
import type { TopicSlug } from '~/content/types'
import { EMBLEM_ALT } from '~/lib/emblems'
import { pigments } from '~/lib/tokens'

interface Props {
  topic: TopicSlug
  size: number
  deep?: boolean
}
const { topic, size, deep = false } = Astro.props
---

<div class:list={['niche', { deep }]} style={`--ground:${pigments[topic].hex};--size:${size}px`}>
  <Emblem name={topic} alt={EMBLEM_ALT[topic]} size={Math.round(size * 0.86)} />
</div>

<style>
  .niche {
    position: relative;
    display: grid;
    place-items: end center;
    flex-shrink: 0;
    width: var(--size);
    height: calc(var(--size) * 1.12);
  }
  .niche::before {
    content: '';
    position: absolute;
    inset: calc(var(--size) * 0.16) calc(var(--size) * 0.06) 0;
    border-radius: 999px 999px 3px 3px;
    background: var(--ground);
  }
  .deep::before {
    background: color-mix(in srgb, var(--ground) 78%, black);
  }
  .niche > :global(.emblem) {
    position: relative;
    margin-bottom: calc(var(--size) * 0.1);
  }
</style>
