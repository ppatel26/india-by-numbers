---
/** The lac seal mark. Colour follows the text colour. */
import seal from '~/assets/brand/seal.svg?raw'

interface Props {
  size?: number
  class?: string
}
const { size = 32, class: cls } = Astro.props
---

<span class:list={['seal', cls]} style={`width:${size}px;height:${size}px`} set:html={seal} />

<style>
  .seal {
    display: inline-block;
    flex-shrink: 0;
  }
  .seal :global(svg) {
    width: 100%;
    height: 100%;
  }
</style>
