---
import type { Chart } from '~/content/types'
import { heat, tableOf } from '~/lib/charts/table'
import { fmt } from '~/lib/format'
import { colorVar, textOn } from '~/lib/tokens'
import { isPlace } from '~/lib/geography'

interface Props {
  chart: Chart
}
const { chart } = Astro.props
const t = tableOf(chart)
const bins = chart.kind === 'table' ? chart.bins : undefined
// Bin edges print in the chart's unit (40%), as round numbers.
const edge = (n: number) => fmt(n, { ...chart.format, decimals: undefined })
const legend = bins?.map((e, i, all) => ({ fill: heat(bins, e), label: i === all.length - 1 ? `${edge(e)} and over` : `${edge(e)} to under ${edge(all[i + 1]!)}` }))
---

{bins && (
  <p class="heat-key">
    <span><i style={`background:${colorVar(heat(bins, -Infinity))}`}></i>Under {edge(bins[0]!)}</span>
    {legend!.map((l) => <span><i style={`background:${colorVar(l.fill)}`}></i>{l.label}</span>)}
  </p>
)}

<div class:list={['scroll', { full: chart.kind === 'table' }]} tabindex="0" role="region" aria-label={`${chart.title}: table`}>
  <table class="ruled">
    <caption class="visually-hidden">{chart.title}</caption>
    <thead>
      <tr>{t.columns.map((c, i) => <th scope="col" class:list={{ num: i > 0 }}>{c}</th>)}</tr>
    </thead>
    <tbody>
      {t.rows.map((r) => (
        <tr data-geo={isPlace(r.key) || r.key === 'india' ? r.key : undefined}>
          <th scope="row">{isPlace(r.key) ? <a href={`/states/${r.key}/`}>{r.head}</a> : r.head}</th>
          {r.cells.map((c) => (
            <td class="num" data-alt={c.shown.alt} style={c.fill && `background:${colorVar(c.fill)};color:${textOn(c.fill)}`}>{c.shown.text}</td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .heat-key {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin-bottom: 12px;
    font-size: 13px;
  }
  .heat-key span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .heat-key i {
    width: 14px;
    height: 14px;
    border-radius: 2px;
  }
  /* A table behind a chart tab scrolls in a box. A shadow at the bottom edge shows there is more;
     the paper gradient moves with the content and covers the shadow at the end. */
  .scroll {
    max-height: 560px;
    overflow: auto;
    background:
      linear-gradient(transparent, var(--paper) 70%) bottom / 100% 32px no-repeat local,
      radial-gradient(farthest-side at 50% 100%, rgb(22 24 29 / 0.14), transparent) bottom / 100% 12px no-repeat scroll;
  }
  /* A table that is the whole chart shows every row. */
  .scroll.full {
    max-height: none;
    background: none;
  }
  thead th {
    position: sticky;
    top: 0;
    background: var(--paper);
  }
  tr[data-geo='india'] th,
  tr[data-geo='india'] td {
    font-weight: 600;
  }
  :global(.is-sel) th {
    font-weight: 600;
  }
</style>
