---
/** The head of an index or about page: breadcrumb, title, Hindi title, intro. The slot sits at the right of the intro. */
import Crumbs from './Crumbs.astro'

interface Props {
  title: string
  hindi?: string
  intro?: string
}
const { title, hindi, intro } = Astro.props
---

<header class="wrap head">
  <Crumbs current={title} />
  <h1 class="display">{title} {hindi && <span class="deva muted" lang="hi">{hindi}</span>}</h1>
  <div class="row">
    {intro && <p class="lede">{intro}</p>}
    <slot />
  </div>
</header>

<style>
  .head {
    padding-block: 48px 32px;
  }
  h1 {
    margin-top: 12px;
    font-size: clamp(40px, 5.4vw, 64px);
  }
  .deva {
    display: inline-block;
    margin-left: 8px;
    font-size: 0.46em;
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px 48px;
    flex-wrap: wrap;
    margin-top: 16px;
  }
  .lede {
    max-width: 700px;
  }
</style>
