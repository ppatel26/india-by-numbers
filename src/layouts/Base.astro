---
import '~/styles/global.css'
import Nav from '~/components/Nav.astro'
import Footer from '~/components/Footer.astro'
import { NOINDEX, SITE, ogImagePath } from '~/lib/site'
import { tokenCss } from '~/lib/tokens'

interface Props {
  title: string
  description: string
  /** Alt text for the social image. */
  imageAlt?: string
  type?: 'website' | 'article'
  /** The state a state page is about: its charts mark it. */
  pageState?: string
  /** The state the home page shows before the reader picks one. */
  defaultState?: string
}

const { title, description, imageAlt, type = 'website', pageState, defaultState } = Astro.props
const path = Astro.url.pathname
const canonical = new URL(path, Astro.site)
const image = new URL(ogImagePath(path), Astro.site)
const full = path === '/' ? `${SITE.name}: ${SITE.tagline}` : `${title} | ${SITE.name}`
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {NOINDEX && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="India by Numbers: releases" href="/releases/feed.xml" />
    <meta name="theme-color" content="#99221F" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt ?? title} />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <style is:inline set:html={tokenCss()} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main" data-page-state={pageState} data-default-state={defaultState}>
      <slot />
    </main>
    <Footer />
    <div class="tip" role="status" hidden></div>
    <script>
      import '~/scripts/site'
    </script>
  </body>
</html>

<style is:global>
  .skip {
    position: absolute;
    left: 8px;
    top: -48px;
    padding: 8px 12px;
    background: var(--ink);
    color: var(--paper);
    z-index: 60;
  }
  .skip:focus {
    top: 8px;
  }
</style>
