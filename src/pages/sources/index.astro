---
/** The publishers, how many charts use each, and the sources we leave out. */
import Base from '~/layouts/Base.astro'
import PageHeader from '~/components/PageHeader.astro'
import TopicTag from '~/components/TopicTag.astro'
import page from '~/content/pages/sources'
import { charts, topic } from '~/content'
import { publisherOf, releasedText, uniqueSources } from '~/lib/sources'
import { pigments } from '~/lib/tokens'

const { publishers, notUsed } = page
const count = new Map<string, number>()
for (const c of charts) {
  for (const p of new Set(c.chart.sources.map((s) => publisherOf(s.publisher)))) count.set(p, (count.get(p) ?? 0) + 1)
}
const sources = uniqueSources(charts.flatMap((c) => c.chart.sources))
/** The newest release among a data set's chart sources; undated releases sort last. */
const latestOf = (short: string, match: RegExp): string | undefined => {
  const dated = sources
    .filter((s) => publisherOf(s.publisher) === short && match.test(s.release) && s.released !== 'not stated')
    .sort((a, b) => b.released.localeCompare(a.released))
  return dated[0] && releasedText(dated[0])
}
const list = publishers.list
  .map((p) => ({ ...p, n: count.get(p.short) ?? 0, sets: p.dataSets.map((d) => ({ ...d, latest: latestOf(p.short, d.match) })) }))
  .sort((a, b) => b.n - a.n)
const max = Math.max(...list.map((p) => p.n))
const barName = (short: string) => short.split(/[ ,]/)[0]
---

<Base title={page.title} description={page.description}>
  <PageHeader title={page.title} hindi={page.hindi}>
    <p class="label muted">{page.checked}</p>
  </PageHeader>

  <div class="wrap">
    <div class="summary">
      <div class="aside">
        <p class="finding">{page.summary.finding}</p>
        <p class="muted">{page.summary.licence}</p>
      </div>
      <figure aria-labelledby="chart-title">
        <h2 id="chart-title"><span class="label muted">{page.chart.number}</span> {page.chart.title}</h2>
        <p class="muted subtitle">{page.chart.subtitle}</p>
        <ol class="bars">
          {list.map((p) => (
            <li>
              <span class="name">{barName(p.short)}</span>
              <span class="track"><span class="bar" style={`width:calc((100% - 40px) * ${p.n / max})`}></span>{p.n}</span>
            </li>
          ))}
        </ol>
        <figcaption class="muted note">{page.chart.note}</figcaption>
      </figure>
    </div>

    <section class="part" aria-labelledby="publishers">
      <p class="label muted">{publishers.eyebrow}</p>
      <h2 class="display" id="publishers">{publishers.heading}</h2>
      {list.map((p) => (
        <article class="publisher">
          <div class="who">
            <div class="name-row">
              <span class="seal" style={`--seal:${pigments[p.topics[0]!].hex}`} data-len={p.mark.length} aria-hidden="true">{p.mark}</span>
              <h3 class="display">{p.short}</h3>
            </div>
            <p class="muted full">{p.full}</p>
            <p class="uses"><strong>{p.n}</strong> {publishers.labels.charts(p.n)}</p>
            <p class="tags">{p.topics.map((t) => <TopicTag topic={topic(t)} />)}</p>
            <dl class="facts">
              <div><dt class="label muted">{publishers.labels.licence}</dt><dd>{p.licence}</dd></div>
              <div><dt class="label muted">{publishers.labels.access}</dt><dd><ul>{p.access.map((a) => <li>{a}</li>)}</ul></dd></div>
              <div><dt class="label muted">{publishers.labels.site}</dt><dd><a href={p.site} rel="external">{new URL(p.site).host.replace(/^www\./, '')}</a></dd></div>
            </dl>
          </div>
          <div class="what">
            <table class="ruled sets">
              <thead>
                <tr>
                  <th scope="col">{publishers.labels.dataSet}</th>
                  <th scope="col">{publishers.labels.detail}</th>
                  <th scope="col">{publishers.labels.rhythm}</th>
                  <th scope="col">{publishers.labels.latest}</th>
                </tr>
              </thead>
              <tbody>
                {p.sets.map((d) => (
                  <tr>
                    <th scope="row">{d.name}</th>
                    <td data-label={publishers.labels.detail}>{d.detail}</td>
                    <td data-label={publishers.labels.rhythm}>{d.rhythm}</td>
                    <td data-label={publishers.labels.latest} class="date">{d.latest ?? publishers.labels.notStated}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            {p.note && <p class="muted note">Note: {p.note}</p>}
          </div>
        </article>
      ))}
    </section>

    <section class="part last" aria-labelledby="not-used">
      <p class="label muted">{notUsed.eyebrow}</p>
      <h2 class="display" id="not-used">{notUsed.heading}</h2>
      <table class="ruled">
        <thead>
          <tr><th scope="col">{notUsed.heads.source}</th><th scope="col">{notUsed.heads.why}</th></tr>
        </thead>
        <tbody>
          {notUsed.rows.map((r) => (
            <tr><th scope="row">{r.source}</th><td>{r.why}</td></tr>
          ))}
        </tbody>
      </table>
    </section>
  </div>
</Base>

<style>
  .summary {
    display: grid;
    grid-template-columns: 320px minmax(0, 1fr);
    gap: 48px;
  }
  .aside,
  figure {
    margin: 0;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
  }
  .finding {
    font-size: 17px;
    line-height: 28px;
  }
  .aside .muted {
    margin-top: 12px;
    font-size: 14px;
    line-height: 24px;
  }
  figure h2 {
    font: 600 17px/24px var(--font-ui);
  }
  figure h2 .label {
    margin-right: 4px;
  }
  .subtitle {
    margin-top: 4px;
    font-size: 15px;
  }
  .bars {
    display: grid;
    gap: 8px;
    margin: 24px 0 0;
    padding: 0 0 20px;
    list-style: none;
    border-bottom: 1px solid var(--rule);
    font-size: 13px;
    line-height: 20px;
  }
  .bars li {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    align-items: center;
    gap: 16px;
  }
  .name {
    text-align: right;
  }
  .track {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .bar {
    height: 16px;
    background: var(--ink);
  }
  .note {
    margin-top: 12px;
    font-size: 13px;
    line-height: 20px;
  }
  .part {
    margin-top: 64px;
    padding-top: 20px;
    border-top: 2px solid var(--ink);
  }
  .last {
    padding-bottom: 96px;
  }
  .part > h2 {
    margin: 8px 0 28px;
    font-size: clamp(32px, 4vw, 44px);
  }
  .publisher {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: 48px;
    padding-block: 36px;
    border-top: 1px solid var(--ink);
  }
  .name-row {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  /* A typographic seal, not the publisher's own emblem: the site is not affiliated with them.
     The ring takes the topic colour; the letters stay ink, so light pigments keep their contrast. */
  .seal {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 1.5px solid var(--seal);
    box-shadow: inset 0 0 0 3px var(--paper), inset 0 0 0 4px var(--seal);
    color: var(--ink);
    font: 400 17px/1 var(--font-display);
    letter-spacing: 0.02em;
  }
  .seal[data-len='4'] {
    font-size: 15px;
  }
  .seal[data-len='5'] {
    font-size: 13px;
  }
  .publisher h3 {
    font-size: 32px;
    text-transform: none;
  }
  .full {
    margin-top: 12px;
    font-size: 15px;
    line-height: 22px;
  }
  .uses {
    margin-top: 16px;
    font-size: 15px;
  }
  .uses strong {
    font: 500 28px/34px var(--font-ui);
    margin-right: 4px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
  }
  .facts {
    margin: 20px 0 0;
    border-top: 1px solid var(--rule);
  }
  .facts div {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 12px;
    padding-block: 10px;
    border-bottom: 1px solid var(--rule);
  }
  .facts dt {
    padding-top: 3px;
  }
  .facts dd {
    margin: 0;
    font-size: 14px;
    line-height: 20px;
  }
  .facts ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 4px;
  }
  .sets {
    width: 100%;
  }
  .sets th[scope='col'] {
    text-align: left;
  }
  .ruled.sets th[scope='row'] {
    width: 26%;
  }
  .ruled.sets td {
    font-size: 15px;
    line-height: 22px;
    vertical-align: top;
    padding-right: 16px;
  }
  .sets .date {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .what .note {
    margin-top: 14px;
    font-size: 14px;
    line-height: 21px;
  }
  .ruled thead th {
    border-bottom: 1px solid var(--ink);
  }
  .ruled th[scope='row'] {
    width: 32%;
    font: 600 15px/22px var(--font-ui);
    padding: 14px 12px 14px 0;
    vertical-align: top;
  }
  .ruled td {
    padding-block: 14px;
  }
  @media (max-width: 900px) {
    .summary,
    .publisher {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
  @media (max-width: 720px) {
    .sets thead {
      display: none;
    }
    .sets tr {
      display: grid;
      gap: 4px;
      padding-block: 12px;
      border-bottom: 1px solid var(--rule);
    }
    .ruled.sets th[scope='row'],
    .ruled.sets td {
      width: auto;
      padding: 0;
      border: 0;
    }
    .sets td::before {
      content: attr(data-label) ': ';
      color: var(--slate);
    }
    .ruled th[scope='row'] {
      width: 40%;
    }
  }
</style>
