---
import '~/styles/scripts.css'
import Base from '~/layouts/Base.astro'
import PageHeader from '~/components/PageHeader.astro'
import states from '~/content/pages/states'
import { placed } from '~/content'
import { renderTiles } from '~/lib/charts/states'
import { byState, statesOf } from '~/lib/charts/model'
import { places } from '~/lib/geography'
import { sourceLine } from '~/lib/sources'
import { checkedOf } from '~/lib/site'

const maps = states.map.measures.map((m, i) => {
  const chart = byState(placed(m.chart).chart)
  if (!chart) throw new Error(`${m.chart} has no value per state`)
  const n = statesOf(chart).values.filter((v) => v.pt?.y != null).length
  return { m, chart: { ...chart, slug: `states-${chart.slug}` }, slug: chart.slug, n, open: i === 1 }
})
const groups = [
  { id: 'states', label: `States (${places.filter((p) => p.type === 'state').length})`, list: places.filter((p) => p.type === 'state') },
  { id: 'uts', label: `Union territories (${places.filter((p) => p.type === 'ut').length})`, list: places.filter((p) => p.type === 'ut') },
]
---

<Base title={states.title} description={states.intro}>
  <PageHeader title={states.title} hindi={states.hindi} intro={states.intro} />

  <section class="wrap" aria-label="Map">
    <div class="switch">
      <p class="label muted" id="map-measure">{states.map.switcherLabel}</p>
      <div class="measures" role="group" aria-labelledby="map-measure">
        {maps.map((x) => (
          <button type="button" data-measure={x.slug} aria-pressed={x.open ? 'true' : 'false'}>{x.m.label}</button>
        ))}
      </div>
    </div>
    {maps.map((x) => (
      <figure class="map" data-map={x.slug} hidden={!x.open}>
        <h2><a href={`/charts/${x.slug}/`}>{x.chart.title}</a></h2>
        <p class="muted">{x.chart.subtitle} {states.map.coverage(x.n, places.length)} states and UTs have data.</p>
        <div class="w-page" set:html={renderTiles(x.chart, 'page').html} />
        <div class="w-wide" set:html={renderTiles(x.chart, 'wide').html} />
        <div class="w-narrow" set:html={renderTiles(x.chart, 'narrow').html} />
        {x.chart.note && <p class="note">Note: {x.chart.note}</p>}
        <figcaption class="note">{sourceLine(x.chart.sources, true, checkedOf(x.chart))}</figcaption>
      </figure>
    ))}
  </section>

  <section class="wrap section" aria-labelledby="a-z">
    <div class="section-head">
      <div>
        <p class="label muted">{states.aToZ.eyebrow}</p>
        <h2 class="display" id="a-z">{states.aToZ.heading}</h2>
      </div>
      <label class="filter">
        <span class="visually-hidden">{states.aToZ.filterPlaceholder}</span>
        <input type="search" placeholder={states.aToZ.filterPlaceholder} data-filter="#a-z-lists li" />
      </label>
    </div>
    <div class="lists" id="a-z-lists">
      {groups.map((g) => (
        <div id={g.id} data-filter-group>
          <h3 class="label muted">{g.label}</h3>
          <ul>
            {g.list.map((p) => (
              <li data-words={`${p.name} ${p.hindi ?? ''} ${p.native?.name ?? ''} ${p.code}`.toLowerCase()}>
                <a href={`/states/${p.slug}/`}>{p.name}</a>
                {p.native ? (
                  <span class="native muted" lang={p.native.lang} dir={p.native.rtl ? 'rtl' : undefined}>{p.native.name}</span>
                ) : (
                  <span class="official muted">Official: {p.official.join(', ')}</span>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="none muted" role="status" hidden data-filter-empty>No state or UT matches.</p>
    <p class="note">{states.aToZ.note}</p>
  </section>

  <section class="wrap section" aria-labelledby="bounds">
    <div class="section-head">
      <div>
        <p class="label muted">{states.boundaries.eyebrow}</p>
        <h2 class="display" id="bounds">{states.boundaries.heading}</h2>
        <p>{states.boundaries.intro}</p>
      </div>
    </div>
    <dl class="changes">
      {states.boundaries.changes.map((c) => (
        <div><dt><strong>{c.heading}</strong></dt><dd>{c.body}</dd></div>
      ))}
    </dl>
    <table class="ruled cover">
      <thead>
        <tr>
          <th scope="col">{states.boundaries.coverageHeads.dataSet}</th>
          <th scope="col">{states.boundaries.coverageHeads.period}</th>
          <th scope="col" class="num">{states.boundaries.coverageHeads.of36}</th>
          <th scope="col">{states.boundaries.coverageHeads.gaps}</th>
        </tr>
      </thead>
      <tbody>
        {states.boundaries.coverage.map((r) => (
          <tr><td>{r.dataSet}</td><td>{r.period}</td><td class="num">{r.of36}</td><td>{r.gaps}</td></tr>
        ))}
      </tbody>
    </table>
  </section>
  <div class="end"></div>
</Base>

<script>
  // One measure at a time: the pressed button names the map that shows.
  document.querySelector('.measures')?.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('[data-measure]')
    if (!b) return
    document.querySelectorAll<HTMLButtonElement>('[data-measure]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)))
    document.querySelectorAll<HTMLElement>('[data-map]').forEach((m) => (m.hidden = m.dataset.map !== b.dataset.measure))
  })
</script>

<style>
  .switch {
    display: grid;
    gap: 10px;
    margin-block: 8px 28px;
  }
  .measures {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .measures button {
    padding: 7px 14px;
    border: 1px solid var(--rule);
    border-radius: 18px;
    background: var(--paper);
    font: 500 14px var(--font-ui);
    color: var(--ink);
    cursor: pointer;
  }
  .measures button:hover {
    border-color: var(--ink);
  }
  @media (max-width: 720px) {
    /* Phones: one swipeable row instead of a tall stack. */
    .measures {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
    }
    .measures button {
      flex-shrink: 0;
    }
  }
  .measures button[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  .map {
    margin: 0;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
  }
  .map h2 {
    font: 600 20px/28px var(--font-ui);
  }
  .map h2 a {
    text-decoration: none;
  }
  .map > p {
    margin-block: 4px 20px;
    font-size: 15px;
  }
  /* The map fills the page row: page width on large screens, chart width below, the phone layout under 720 px. */
  .w-wide,
  .w-narrow {
    display: none;
  }
  @media (max-width: 1199px) {
    .w-page {
      display: none;
    }
    .w-wide {
      display: block;
    }
  }
  @media (max-width: 720px) {
    .w-wide {
      display: none;
    }
    .w-narrow {
      display: block;
    }
  }
  .none {
    margin-top: 24px;
    font-size: 17px;
  }
  .note {
    margin-top: 12px;
    font-size: 13px;
    line-height: 19px;
    color: var(--slate);
    max-width: 760px;
  }
  .filter input {
    width: 280px;
    padding: 8px 12px;
    font: 400 15px var(--font-ui);
    border: 1px solid var(--rule);
    border-radius: 20px;
  }
  .lists {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 48px;
    margin-top: 24px;
  }
  .lists ul {
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
    columns: 2;
    column-gap: 32px;
  }
  #uts ul {
    columns: 1;
  }
  /* Name, then the name in the state's own script under it: one left edge for every script. */
  .lists li {
    display: grid;
    gap: 2px;
    padding-block: 10px;
    border-bottom: 1px solid var(--rule);
    break-inside: avoid;
  }
  .lists .native {
    font-size: 16px;
    line-height: 1.6;
    text-align: left;
  }
  .lists .official {
    font-size: 14px;
    line-height: 1.8;
  }
  .lists .native:lang(ur) {
    font-size: 15px;
    line-height: 2;
  }
  .lists li a {
    font-weight: 600;
    text-decoration: none;
  }
  .lists li a:hover {
    text-decoration: underline;
  }
  .changes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin: 24px 0;
  }
  .changes dd {
    margin: 8px 0 0;
    font-size: 15px;
    line-height: 23px;
  }
  .cover {
    margin-top: 32px;
  }
  .end {
    height: 96px;
  }
  @media (max-width: 900px) {
    .lists,
    .changes {
      grid-template-columns: 1fr;
    }
    .lists ul {
      columns: 1;
    }
    .filter input {
      width: 100%;
    }
  }
</style>
