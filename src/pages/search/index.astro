---
/** Search results. src/scripts/search.ts reads ?q= and fills the list from /search.json. */
import Base from '~/layouts/Base.astro'
import PageHeader from '~/components/PageHeader.astro'
import chrome from '~/content/pages/chrome'
import topicsPage from '~/content/pages/topics'
---

<Base title="Search" description={chrome.searchPlaceholder}>
  <PageHeader breadcrumb="Home / Search" title="Search">
    <form class="box" action="/search/" method="get" role="search" aria-label="Search results">
      <label class="visually-hidden" for="page-q">{chrome.searchPlaceholder}</label>
      <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"><circle cx="7" cy="7" r="5" fill="none" stroke="currentColor" stroke-width="1.5"></circle><path d="M11 11l3.5 3.5" stroke="currentColor" stroke-width="1.5"></path></svg>
      <input id="page-q" name="q" type="search" placeholder={chrome.searchPlaceholder} autocomplete="off" />
      <button type="submit">Search</button>
    </form>
  </PageHeader>

  <div class="wrap page">
    <p class="label muted count" aria-live="polite" data-search-count></p>
    <ul class="results" data-search-results></ul>
    <div class="empty" data-search-empty hidden>
      <h2>No results</h2>
      <p>Try another word, or browse <a href="/topics/">all topics</a>.</p>
      <p class="muted">{topicsPage.comingLater.heading}: {topicsPage.comingLater.topics.join(', ')}. {topicsPage.comingLater.intro}</p>
    </div>
  </div>
</Base>

<style>
  .box {
    display: flex;
    align-items: center;
    gap: 12px;
    width: min(720px, 100%);
    height: 60px;
    padding: 0 6px 0 20px;
    border: 1px solid var(--ink);
    border-radius: 30px;
  }
  .box:focus-within {
    outline: 2px solid var(--s5);
    outline-offset: 2px;
  }
  input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    font: 400 20px var(--font-ui);
    color: var(--ink);
    outline: none;
  }
  button {
    height: 46px;
    padding-inline: 22px;
    border: 0;
    border-radius: 23px;
    background: var(--ink);
    color: var(--paper);
    font: 600 15px var(--font-ui);
    cursor: pointer;
  }
  .page {
    min-height: 40vh;
    padding-bottom: 112px;
  }
  .count {
    padding-bottom: 12px;
    border-bottom: 2px solid var(--ink);
  }
  .count:empty {
    border: 0;
  }
  .results {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .results :global(a) {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 2px 16px;
    padding-block: 14px;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
  }
  .results :global(.label) {
    grid-row: span 2;
    padding-top: 4px;
  }
  .results :global(.t) {
    font-weight: 600;
  }
  .results :global(a:hover .t) {
    text-decoration: underline;
  }
  .results :global(.d) {
    font-size: 15px;
    line-height: 22px;
  }
  .empty h2 {
    font: 600 20px/28px var(--font-ui);
  }
  .empty p {
    margin-top: 8px;
  }
  .empty .muted {
    font-size: 15px;
  }
</style>
