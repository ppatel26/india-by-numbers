---
import Base from '~/layouts/Base.astro'
import ChartFrame from '~/components/ChartFrame.astro'
import TopicHero from '~/components/topic/TopicHero.astro'
import MetaStrip from '~/components/topic/MetaStrip.astro'
import Rail from '~/components/topic/Rail.astro'
import AboutData from '~/components/topic/AboutData.astro'
import { charts, partId, topics } from '~/content'
import type { Topic } from '~/content/types'

export function getStaticPaths() {
  return topics.map((topic) => ({ params: { topic: topic.slug }, props: { topic } }))
}

interface Props {
  topic: Topic
}
const { topic } = Astro.props
const numbered = new Map(charts.filter((c) => c.topic.slug === topic.slug).map((c) => [c.chart.slug, c.number]))
---

<Base title={`${topic.name}: charts and data`} description={topic.standfirst} imageAlt={`${topic.name} in India: headline figures`}>
  <TopicHero topic={topic} />
  <MetaStrip topic={topic} />
  <div class="wrap layout">
    <Rail topic={topic} />
    <div class="main">
      {topic.parts.map((part, i) => (
        <section class="part" id={partId(i + 1)} aria-labelledby={`${partId(i + 1)}-title`}>
          <p class="label muted">Part {i + 1}</p>
          <h2 class="display" id={`${partId(i + 1)}-title`}>{part.title}</h2>
          <p class="lede">{part.lede}</p>
          {part.blocks.map((b) =>
            'chart' in b ? (
              <ChartFrame chart={b.chart} number={numbered.get(b.chart.slug)} />
            ) : (
              <p class="finding">{b.text}</p>
            ),
          )}
        </section>
      ))}
    </div>
  </div>
  <AboutData topic={topic} partNo={topic.parts.length + 1} />
</Base>

<style>
  .layout {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, var(--main));
    gap: 48px;
    justify-content: space-between;
    padding-top: 48px;
  }
  .part {
    padding-top: 20px;
    border-top: 2px solid var(--ink);
    display: grid;
    gap: 0;
  }
  .part + .part {
    margin-top: 96px;
  }
  h2 {
    margin-top: 10px;
    font-size: clamp(30px, 3.6vw, 44px);
  }
  .lede {
    margin-top: 16px;
  }
  .part > :global(.chart) {
    margin-top: 32px;
  }
  .finding {
    margin-top: 48px;
    max-width: 640px;
    font-size: 17px;
    line-height: 28px;
  }
  .finding + :global(.chart) {
    margin-top: 24px !important;
  }
  @media (max-width: 1100px) {
    .layout {
      grid-template-columns: 1fr;
    }
  }
</style>
